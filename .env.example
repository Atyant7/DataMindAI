# ============================================================
# DataMind AI - Centralized Environment Configuration
# ============================================================

ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Database (Development: SQLite, Production: PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/datamind_db
DATABASE_URL=sqlite:///artifacts/datamind.db

# Storage configuration
STORAGE_PATH=artifacts/storage
MAX_UPLOAD_SIZE=100

# Local LLM - Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
